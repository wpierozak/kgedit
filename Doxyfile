# Run from the repository root: mkdir -p build && doxygen Doxyfile
PROJECT_NAME           = kgedit
PROJECT_BRIEF          = "Offline RDF versioning and Neo4j artifact generation"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = include \
                         src \
                         instances/include \
                         instances/src \
                         archive/legacy_database/include \
                         archive/legacy_database/src
FILE_PATTERNS          = *.hxx *.cxx
RECURSIVE              = YES
INCLUDE_PATH           = include \
                         instances/include \
                         archive/legacy_database/include
EXCLUDE_SYMBOLS        = _xmlNode
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
GENERATE_XML           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
